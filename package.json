{
  "name": "cfop_solver_web",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run-with-env.mjs development tsx watch server/_core/index.ts",
    "embed-solver": "node scripts/embed-solver.mjs",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node scripts/run-with-env.mjs production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium playwright test",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:setup": "node scripts/setup-local-db.mjs",
    "db:stop": "docker compose -f compose.local.yaml down",
    "db:reset": "docker compose -f compose.local.yaml down -v",
    "db:logs": "docker compose -f compose.local.yaml logs -f database"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
    "@aws-sdk/s3-request-presigner": "^3.693.0",
    "@hookform/resolvers": "^5.2.2",
    "@popperjs/core": "^2.11.8",
    "@react-buddy/ide-toolbox": "^2.5.0",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "^1.13.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie": "^1.0.2",
    "cubing": "^0.63.4",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.3.0",
    "framer-motion": "^12.23.22",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "mysql2": "^3.15.0",
    "nanoid": "^5.1.16",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.64.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "superjson": "^1.13.3",
    "three": "^0.170.0",
    "vaul": "^1.1.2",
    "wouter": "3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "5.0.6",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^5.2.0",
    "add": "^2.0.6",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "pnpm": "^10.34.5",
    "prettier": "^3.6.2",
    "rollup": "^4.59.0",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-manus-runtime": "0.0.59",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.5"
}
