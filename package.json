{
  "name": "cfop_solver_web",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/fetch-pyodide.mjs && node scripts/run-with-env.mjs development tsx watch server/_core/index.ts",
    "embed-solver": "node scripts/embed-solver.mjs",
    "fetch-pyodide": "node scripts/fetch-pyodide.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "build": "node scripts/fetch-pyodide.mjs && node scripts/run-with-env.mjs production node node_modules/vite/bin/vite.js build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --splitting --outdir=dist && node scripts/verify-pyodide-dist.mjs",
    "start": "node scripts/run-with-env.mjs production node dist/index.js",
    "check": "tsc --noEmit",
    "audit:classes": "node scripts/audit-bootstrap-classes.mjs && node scripts/audit-tailwind-classes.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:setup": "node scripts/setup-local-db.mjs",
    "db:stop": "docker compose -f compose.local.yaml down",
    "db:reset": "docker compose -f compose.local.yaml down -v",
    "db:logs": "docker compose -f compose.local.yaml logs -f database"
  },
  "dependencies": {
    "@react-buddy/ide-toolbox": "^2.5.0",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.28.0",
    "@trpc/react-query": "^11.28.0",
    "@trpc/server": "^11.28.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cookie": "^2.0.2",
    "cubing": "^0.66.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.72.0",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "three": "^0.170.0",
    "wouter": "3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "pyodide": "0.27.7",
    "rollup": "^4.68.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-manus-runtime": "0.0.59",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    }
  }
}
