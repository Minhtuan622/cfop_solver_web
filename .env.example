# Required by the platform (database, process identity)
DATABASE_URL=mysql://cfop:cfop_local@127.0.0.1:3307/cfop_solver
NODE_ENV=production
PORT=3000

# The public address of the site, used for canonical URLs and structured data.
VITE_SITE_URL=https://cfop-solver.studio/

# Optional integrations
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=
# WCA OAuth redirect; http is accepted only on localhost/127.0.0.1 outside
# production. In production this must be https.
WCA_OAUTH_REDIRECT_URI=http://localhost:3000/api/wca/oauth/callback
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CFOP_APP_URL=http://localhost:3000

# Tell Express to trust the X-Forwarded-* headers of the proxy in front of it
# (unset, "false" or "0" = no trust; a number = that many hops).
TRUST_PROXY=
