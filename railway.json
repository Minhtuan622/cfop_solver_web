{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "client/**",
      "server/**",
      "shared/**",
      "drizzle/**",
      "scripts/**",
      "packages/solver/**",
      "Dockerfile",
      "package.json",
      "pnpm-lock.yaml",
      "vite.config.ts"
    ]
  },
  "deploy": {
    "startCommand": "sh -c \"node scripts/migrate.mjs && exec node dist/index.js\"",
    "healthcheckPath": "/_app/ready",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
