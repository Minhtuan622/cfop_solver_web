{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build",
    "watchPatterns": [
      "client/**",
      "server/**",
      "shared/**",
      "drizzle/**",
      "scripts/**",
      "package.json",
      "pnpm-lock.yaml",
      "vite.config.ts"
    ]
  },
  "deploy": {
    "startCommand": "pnpm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
